<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Solicitud de Pedido - Tienda Tec</title>
</head>
<body>
    <header>
        <h1>Formulario de Pedido de Producto</h1>
    </header>

    <main>
        <form action="#" method="post">
            <fieldset>
                <legend>Datos del Solicitante</legend>

                <div>
                    <label for="nombreCliente">Nombre completo:</label>
                    <input type="text" id="nombreCliente" name="nombreCliente" required>
                </div>

                <div>
                    <label for="correoElectronico">Correo electrónico:</label>
                    <input type="email" id="correoElectronico" name="correoElectronico" required>
                </div>
            </fieldset>

            <fieldset>
                <legend>Detalles del Pedido</legend>

                <div>
                    <label for="productoSeleccionado">Producto a solicitar:</label>
                    <select id="productoSeleccionado" name="productoSeleccionado" required>
                        <option value="">-- Selecciona un producto --</option>
                        <option value="1">Ellen Joe Colegiana</option>
                        <option value="2">Ellen Joe Maid</option>
                        <option value="3">Ellen Joe Bikini</option>
                    </select>
                </div>

                <div>
                    <label for="cantidadSolicitada">Cantidad:</label>
                    <input type="number" id="cantidadSolicitada" name="cantidadSolicitada" min="1" max="10" value="1" required>
                </div>

                <div>
                    <label for="fechaEntrega">Fecha preferida de entrega:</label>
                    <input type="date" id="fechaEntrega" name="fechaEntrega" required>
                </div>

                <div>
                    <label for="comentariosAdicionales">Comentarios u observaciones:</label>
                    <textarea id="comentariosAdicionales" name="comentariosAdicionales" rows="4" cols="50"></textarea>
                </div>
            </fieldset>

            <button type="submit">Enviar Solicitud</button>
        </form>
    </main>
</body>
</html>
